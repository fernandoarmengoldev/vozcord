# ---------- Red ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# IP que se anuncia a los clientes WebRTC (IP LAN del servidor, o IP pública en producción). OBLIGATORIA.
MEDIASOUP_ANNOUNCED_IP=192.168.1.52
# Puerto único UDP+TCP para todo el tráfico WebRTC (abrirlo en el firewall / publicarlo en Docker)
MEDIASOUP_PORT=40000

# ---------- TLS opcional ----------
# Déjalo vacío si hay un proxy (Traefik/Dokploy/Caddy) delante que termina HTTPS.
# Para HTTPS directo en LAN: ./scripts/generate-dev-cert.sh <IP>
TLS_CERT_FILE=
TLS_KEY_FILE=

# ---------- Bases de datos ----------
TURSO_DATABASE_URL=libsql://<db>.turso.io
TURSO_AUTH_TOKEN=
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>

# ---------- Seguridad ----------
JWT_SECRET=<cadena-aleatoria-larga>

# ---------- Transcripción (opcional) ----------
FIREWORKS_API_KEY=
