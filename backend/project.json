{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/backend",
  "projectType": "application",
  "tags": ["type:app", "platform:server"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run index.ts",
        "cwd": "packages/backend"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run index.ts",
        "cwd": "packages/backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint",
        "cwd": "packages/backend"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/backend"
      }
    }
  }
}
